# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub (.gitignore).
# Guia completo: docs/INTEGRACAO_EMAIL.md

# true = envia e-mail ao fornecedor ao confirmar um pedido. false = modo simulação.
EXPO_PUBLIC_EMAIL_FORNECEDOR_ATIVO=false

# Supabase > Project Settings > API (ou Data API)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). NUNCA coloque aqui a service_role/secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
